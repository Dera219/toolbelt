# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
#   cp api/.env.example api/.env
#
# Every variable takes the TOOLBELT_ prefix; see app/core/config.py.

# ---------------------------------------------------------------- environment
TOOLBELT_ENVIRONMENT=dev            # dev | test | prod

# ------------------------------------------------------------------- security
# Generate with: openssl rand -hex 32
# Required in prod — startup fails if this is the dev default or under 32 bytes.
TOOLBELT_JWT_SECRET=dev-only-secret-change-me

# ------------------------------------------------------------------- database
TOOLBELT_DATABASE_URL=sqlite:///./toolbelt.db

# ---------------------------------------------------------------- public URLs
# Stripe Connect onboarding redirects here. Must be a real public https origin
# in prod — startup fails on localhost.
TOOLBELT_PUBLIC_BASE_URL=http://localhost:8000

# -------------------------------------------------------------------- Stripe
# SECRET key. Full account access — never commit, never ship in a client app,
# never paste into chat or an issue. Leave unset to use FakePaymentProvider.
# Test keys start sk_test_; live keys start sk_live_.
TOOLBELT_STRIPE_SECRET_KEY=

# Webhook signing secret from the Stripe dashboard (whsec_...).
TOOLBELT_PAYMENTS_WEBHOOK_SECRET=dev-webhook-secret-0123456789abcdef

# NOTE: the PUBLISHABLE key (pk_test_/pk_live_) does NOT belong here. It is a
# client-side value and lives in the mobile app — see mobile/.env.example.
