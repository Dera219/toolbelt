# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
#   cp api/.env.example api/.env
#
# Every variable takes the TOOLBELT_ prefix; see app/core/config.py.

# ---------------------------------------------------------------- environment
TOOLBELT_ENVIRONMENT=dev            # dev | test | prod

# ------------------------------------------------------------------- security
# Generate with: openssl rand -hex 32
# Required in prod — startup fails if this is the dev default or under 32 bytes.
TOOLBELT_JWT_SECRET=dev-only-secret-change-me

# ------------------------------------------------------------------- database
TOOLBELT_DATABASE_URL=sqlite:///./toolbelt.db

# ---------------------------------------------------------------- public URLs
# Stripe Connect onboarding redirects here. Must be a real public https origin
# in prod — startup fails on localhost.
TOOLBELT_PUBLIC_BASE_URL=http://localhost:8000

# -------------------------------------------------------------------- Stripe
# SECRET key. Full account access — never commit, never ship in a client app,
# never paste into chat or an issue. Leave unset to use FakePaymentProvider.
# Test keys start sk_test_; live keys start sk_live_.
TOOLBELT_STRIPE_SECRET_KEY=

# Internal HMAC secret for /webhooks/payments (the fake-provider event shape
# the test suite drives). NOT a Stripe value.
TOOLBELT_PAYMENTS_WEBHOOK_SECRET=dev-webhook-secret-0123456789abcdef

# Stripe endpoint signing secret (whsec_...) for POST /webhooks/stripe, from
# Stripe → Developers → Webhooks after registering the endpoint. Leave unset
# to disable the route (it answers 503; polling covers payout state).
TOOLBELT_STRIPE_WEBHOOK_SECRET=

# NOTE: the PUBLISHABLE key (pk_test_/pk_live_) does NOT belong here. It is a
# client-side value and lives in the mobile app — see mobile/.env.example.

# Twilio, for phone verification. Leave blank in dev: DevSmsSender writes the
# code to the log and to an inspectable outbox, which is what the tests read.
# Setting these in dev is useful for pointing staging at a Twilio trial account.
TOOLBELT_TWILIO_ACCOUNT_SID=
# Credentials: an API key pair (preferred — revocable on its own, and
# restrictable to creating Messages) or the account auth token.
TOOLBELT_TWILIO_API_KEY_SID=
TOOLBELT_TWILIO_API_KEY_SECRET=
TOOLBELT_TWILIO_AUTH_TOKEN=
# One of the two below is required alongside the credentials. The messaging
# service wins when both are set.
TOOLBELT_TWILIO_MESSAGING_SERVICE_SID=
TOOLBELT_TWILIO_FROM_NUMBER=
