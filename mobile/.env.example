# Copy to `.env` and fill in. `.env` is gitignored.
#
# Expo exposes anything prefixed EXPO_PUBLIC_ to the client bundle. That is
# correct for a Stripe PUBLISHABLE key — it is designed to be public and can
# only tokenize cards, never charge them.
#
# NEVER put a SECRET key (sk_test_/sk_live_) here. Anything in a mobile bundle
# is extractable from the app binary by anyone who downloads it.

EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: point at a staging API instead of the auto-detected dev host.
# EXPO_PUBLIC_API_URL=https://staging.example.com
